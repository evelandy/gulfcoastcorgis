# Copy this file to `.env` (or `.env.local`) and fill in what you have.
# Every variable the browser can read must start with VITE_.

# Your public domain once you buy it. Used for canonical links and share previews.
VITE_SITE_URL=https://www.gulf-coast-corgis.com

# Leave empty to run on the local JSON files in src/data (no backend needed).
# Set it to your API base when the backend is ready, e.g.
#   VITE_API_URL=/api                       (dev, proxied to localhost:4000 by vite.config.js)
#   VITE_API_URL=https://api.gulfcoastcorgis.com
VITE_API_URL=

# Web3Forms access key for the inquiry form (https://web3forms.com). Submissions go to the inbox
# the key was issued for. Set this on your host too: it is read at build time.
VITE_WEB3FORMS_KEY=

# Optional: where the inquiry form posts if you don't use Web3Forms or a backend.
# Works with Formspree, Getform, Basin, a Zapier/Make webhook, etc.
VITE_INQUIRY_ENDPOINT=

# Show the "Manage listings" link in the footer (true/false). The panel is always at /#admin.
VITE_SHOW_ADMIN_LINK=true
