{
  "name": "gulfcoast-corgis-server",
  "version": "0.1.0",
  "description": "GulfCoast Corgis API (Express + Postgres)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node src/index.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file=.env src/scripts/migrate.js",
    "db:seed": "node --env-file=.env src/scripts/seed.js",
    "db:reset": "node --env-file=.env src/scripts/seed.js --reset",
    "db:psql": "docker compose exec db psql -U gcc gcc"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  }
}
